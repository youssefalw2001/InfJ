# Public Supabase project values. The anon key is safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret for trusted background/admin jobs. Never prefix with NEXT_PUBLIC_;
# never use this in browser code. The current application does not require it to run.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical production URL used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side distributed rate limiting in production.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
