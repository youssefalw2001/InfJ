{
  "name": "manywise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "studio": "pnpm --dir marketing-studio studio",
    "studio:validate": "pnpm --dir marketing-studio validate",
    "studio:calendar": "pnpm --dir marketing-studio calendar",
    "studio:captions": "pnpm --dir marketing-studio captions",
    "studio:render": "pnpm --dir marketing-studio render",
    "studio:render:all": "pnpm --dir marketing-studio render:all",
    "studio:render:manifest": "pnpm --dir marketing-studio render:manifest",
    "studio:render:samples": "pnpm --dir marketing-studio render:samples",
    "studio:verify": "pnpm --dir marketing-studio verify",
    "verify": "pnpm typecheck && pnpm lint && pnpm studio:verify && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
